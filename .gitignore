# Your own discs and everything read or generated from them never go into git
# (LEGAL.md): disc images, the boot executables, splat's assembly and assets,
# build output. tests/check_repository.py checks this.
/baserom/*
!/baserom/README.md
/asm/
/assets/
/build/
*.iso
*.img
*.bin
*.elf
*.o

# The proprietary compiler you supply (docs/TOOLCHAIN.md).
/toolchain
/toolchain/
/wibo

# Left in include/ by splat runs before its macro files were turned off (config/splat/,
# generate_asm_macros_files); include/macro.inc is the project's own now.
/include/include_asm.h
/include/labels.inc

# Tools each contributor fetches for themselves, never distributed (decomp-permuter).
/tools/ext/

# Python and editors
venv/
.venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent worktrees and local settings
.claude/worktrees/
.claude/settings.local.json
